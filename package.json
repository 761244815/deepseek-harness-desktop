{
  "name": "deepseek-harness-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows desktop shell for DeepSeek Harness.",
  "author": "DeepSeek Harness Desktop contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/761244815/deepseek-harness-desktop.git"
  },
  "homepage": "https://github.com/761244815/deepseek-harness-desktop",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "generate-icon": "electron scripts/generate-icon.cjs",
    "ensure-electron": "node node_modules/electron/install.js",
    "smoke:npm-runtime": "node scripts/smoke-npm-runtime.mjs",
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "lib/**/*",
      "shell/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "DeepSeek-Harness-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Desktop-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "761244815",
        "repo": "deepseek-harness-desktop"
      }
    ]
  }
}
